---
// The README's milestone checklist as a block meter and list, plus its
// native-port layers when the README has such a table.
import type { Checklist, Project } from '../lib/github';
import Blocks from './Blocks.astro';
import { useT, type Lang } from '../i18n';

interface Props {
  project: Project;
  lang: Lang;
}
const { project: p, lang } = Astro.props;
const t = useT(lang);
const count = (l: Checklist, step: string) => l.items.filter((i) => i.step === step).length;
const lists = [
  p.milestones && { list: p.milestones, title: t('msEyebrow'), key: 'msDone' as const },
  p.nativeLayers && { list: p.nativeLayers, title: t('nativeEyebrow'), key: 'nativeDone' as const },
].filter(Boolean) as { list: Checklist; title: string; key: 'msDone' | 'nativeDone' }[];
const word = { done: t('stepDone'), wip: t('stepWip'), todo: t('stepTodo') };
---

<section id="milestones" class="milestones panel" aria-label={t('msEyebrow')}>
  {
    lists.map(({ list, title, key }) => (
      <div class="list">
        <header>
          <p class="eyebrow">{title}</p>
          <h2>
            {t(key, { done: count(list, 'done'), total: list.items.length })}
            {count(list, 'wip') > 0 && <span class="wip-count">· {t('inProgress', { n: count(list, 'wip') })}</span>}
          </h2>
          <Blocks steps={list.items.map((i) => i.step)} size="lg" lang={lang} />
        </header>
        <ul>
          {list.items.map((item) => (
            <li class={item.step}>
              <span class="tick" aria-label={word[item.step]} />
              <span lang="en" set:html={item.html} />
            </li>
          ))}
        </ul>
      </div>
    ))
  }
  <p class="source">{t('msSource')}</p>
</section>

<style>
  .milestones {
    margin-top: 36px;
    padding: 22px clamp(18px, 3vw, 32px);
    display: grid;
    gap: 30px;
  }
  h2 {
    margin: 6px 0 12px;
    font-size: 1.5rem;
    font-weight: 300;
    text-shadow: var(--glow);
  }
  .wip-count {
    margin-left: 0.4em;
    font-size: 1rem;
    color: var(--ink-dim);
    text-shadow: none;
  }
  ul {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    columns: 2 320px;
    column-gap: 28px;
  }
  li {
    break-inside: avoid;
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    gap: 10px;
    padding: 6px 0;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--ink);
  }
  li.todo {
    color: var(--ink-faint);
  }
  li :global(code) {
    font-family: var(--mono);
    font-size: 0.85em;
    padding: 0.05em 0.35em;
    border-radius: 4px;
    background: rgb(120 150 255 / 0.12);
  }
  li :global(a) {
    color: hsl(var(--h) 95% 78%);
  }
  .tick {
    width: 16px;
    height: 16px;
    margin-top: 2px;
    border-radius: 4px;
    border: 1.5px solid var(--line-strong);
    display: grid;
    place-items: center;
  }
  .done .tick {
    border-color: hsl(var(--h) 90% 66%);
    background: hsl(var(--h) 90% 60% / 0.25);
  }
  .done .tick::after {
    content: '';
    width: 7px;
    height: 3.5px;
    margin-top: -2px;
    border: solid hsl(var(--h) 90% 80%);
    border-width: 0 0 2px 2px;
    rotate: -45deg;
  }
  .wip .tick {
    border-color: hsl(var(--h) 90% 66% / 0.8);
    background: repeating-linear-gradient(
      135deg,
      hsl(var(--h) 90% 66% / 0.6) 0 2px,
      transparent 2px 4px
    );
  }
  .source {
    margin: -12px 0 0;
    font-size: 0.75rem;
    color: var(--ink-faint);
  }
</style>
