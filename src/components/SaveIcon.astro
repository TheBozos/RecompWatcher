---
// A memory-card style save icon: a glassy cube that idles, and spins when its
// slot is selected (or always, with `spin`).
interface Props {
  short: string;
  hue: number;
  size?: number;
  spin?: boolean;
  kind?: 'game' | 'tool';
}
const { short, hue, size = 84, spin = false, kind = 'game' } = Astro.props;
const faces = ['front', 'back', 'right', 'left', 'top', 'bottom'] as const;
---

<div class:list={['icon', kind, { spin }]} style={`--hue:${hue};--s:${size}px`} aria-hidden="true">
  <div class="cube">
    {
      faces.map((f) => (
        <div class={`face ${f}`}>
          {(f === 'front' || f === 'back' || f === 'right' || f === 'left') && <span>{short}</span>}
        </div>
      ))
    }
  </div>
  <div class="shadow"></div>
</div>

<style>
  .icon {
    --s: 84px;
    width: calc(var(--s) * 1.5);
    height: calc(var(--s) * 1.6);
    display: grid;
    place-items: center;
    perspective: calc(var(--s) * 7);
    position: relative;
  }
  .cube {
    width: var(--s);
    height: var(--s);
    position: relative;
    transform-style: preserve-3d;
    transform: rotateX(-18deg) rotateY(-28deg);
    animation: bob 3.2s ease-in-out infinite;
  }
  .tool .cube {
    scale: 0.88;
  }
  .face {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border: 1px solid hsl(var(--hue) 90% 80% / 0.55);
    background:
      linear-gradient(135deg, hsl(var(--hue) 95% 78% / 0.55), transparent 55%),
      linear-gradient(315deg, hsl(var(--hue) 80% 30% / 0.85), hsl(var(--hue) 85% 52% / 0.5));
    box-shadow:
      inset 0 0 calc(var(--s) * 0.25) hsl(var(--hue) 100% 75% / 0.35),
      0 0 calc(var(--s) * 0.15) hsl(var(--hue) 100% 60% / 0.25);
    backface-visibility: visible;
  }
  .tool .face {
    border-radius: 6px;
    background:
      repeating-linear-gradient(0deg, hsl(var(--hue) 80% 70% / 0.12) 0 2px, transparent 2px 7px),
      linear-gradient(315deg, hsl(var(--hue) 50% 20% / 0.9), hsl(var(--hue) 70% 45% / 0.55));
  }
  .face span {
    font-weight: 700;
    font-size: calc(var(--s) * 0.3);
    letter-spacing: 0.02em;
    color: #fff;
    text-shadow:
      0 0 6px hsl(var(--hue) 100% 70%),
      0 0 18px hsl(var(--hue) 100% 60% / 0.8);
  }
  .front { transform: translateZ(calc(var(--s) / 2)); }
  .back { transform: rotateY(180deg) translateZ(calc(var(--s) / 2)); }
  .right { transform: rotateY(90deg) translateZ(calc(var(--s) / 2)); }
  .left { transform: rotateY(-90deg) translateZ(calc(var(--s) / 2)); }
  .top { transform: rotateX(90deg) translateZ(calc(var(--s) / 2)); }
  .bottom { transform: rotateX(-90deg) translateZ(calc(var(--s) / 2)); }

  .shadow {
    position: absolute;
    bottom: 2%;
    width: calc(var(--s) * 1.1);
    height: calc(var(--s) * 0.16);
    border-radius: 50%;
    background: radial-gradient(hsl(var(--hue) 100% 65% / 0.45), transparent 70%);
    filter: blur(4px);
    animation: shadow 3.2s ease-in-out infinite;
  }

  .spin .cube,
  :global([data-nav]:focus-visible) .cube,
  :global([data-nav]:focus) .cube {
    animation:
      spin 5s linear infinite,
      bob 3.2s ease-in-out infinite;
  }

  @keyframes bob {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 calc(var(--s) * -0.08); }
  }
  @keyframes shadow {
    0%, 100% { opacity: 1; scale: 1; }
    50% { opacity: 0.6; scale: 0.85; }
  }
  @keyframes spin {
    from { transform: rotateX(-18deg) rotateY(-28deg); }
    to { transform: rotateX(-18deg) rotateY(332deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cube, .shadow, .spin .cube { animation: none !important; }
  }
</style>
