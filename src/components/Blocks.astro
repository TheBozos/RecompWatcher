---
// A memory-card style block meter: one block per checklist item, lit when
// done, half-lit while in progress.
import type { Step } from '../lib/github';

interface Props {
  steps: Step[];
  size?: 'sm' | 'lg';
  label?: string;
}
const { steps, size = 'sm', label = 'milestones' } = Astro.props;
const done = steps.filter((s) => s === 'done').length;
const wip = steps.filter((s) => s === 'wip').length;
const summary = `${done} of ${steps.length} ${label} done${wip ? `, ${wip} in progress` : ''}`;
---

<div class={`blocks ${size}`} role="img" aria-label={summary} title={summary}>
  {steps.map((s) => <span class={s} />)}
</div>

<style>
  .blocks {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 2px;
    width: 100%;
  }
  .blocks.sm {
    height: 5px;
    max-width: 120px;
  }
  .blocks.lg {
    height: 14px;
    gap: 3px;
  }
  span {
    border-radius: 1.5px;
    background: rgb(255 255 255 / 0.08);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
  }
  .done {
    background: hsl(var(--h, 220) 90% 66%);
    box-shadow: 0 0 6px hsl(var(--h, 220) 90% 60% / 0.7);
  }
  .wip {
    background: repeating-linear-gradient(
      135deg,
      hsl(var(--h, 220) 90% 66% / 0.75) 0 2px,
      hsl(var(--h, 220) 90% 66% / 0.15) 2px 4px
    );
  }
</style>
