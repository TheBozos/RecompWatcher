---
import '@fontsource-variable/exo-2';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Glyph, { type Button } from '../components/Glyph.astro';

interface Props {
  title: string;
  description?: string;
  /** Backdrop mode for this page. */
  scene?: 'menu' | 'page';
  hue?: number;
  /** Share card path under the site, e.g. "og/dark-cloud.jpg". */
  image?: string;
  /** Button hints shown in the footer. */
  hints?: { button: Button; label: string }[];
}

const {
  title,
  description = 'Native PC ports of PlayStation 2 games, made by static recompilation.',
  scene = 'page',
  hue,
  image = 'og/home.jpg',
  hints = [{ button: 'cross', label: 'Enter' }],
} = Astro.props;
const base = import.meta.env.BASE_URL;
const site = Astro.site ?? new URL('http://localhost:4321');
const absolute = (path: string) => new URL(base.replace(/\/?$/, '/') + path, site).href;
const pageUrl = new URL(Astro.url.pathname, site).href;
// A soft PS2-style zoom-through between pages (keyframes in global.css).
const zoom = {
  old: { name: 'rw-out', duration: '0.28s', easing: 'ease-in', fillMode: 'both' },
  new: { name: 'rw-in', duration: '0.42s', easing: 'ease-out', fillMode: 'both' },
};
const pageAnim = { forwards: zoom, backwards: zoom };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#01030a" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Recomp Watcher" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absolute(image)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
    <ClientRouter fallback="swap" />
  </head>
  <body data-scene={scene} data-hue={hue}>
    <div id="scene" transition:persist="scene" aria-hidden="true"></div>
    <div class="vignette" aria-hidden="true"></div>

    <header class="topbar">
      <a href={base} class="brand" data-brand>
        <span class="brand-mark">RECOMP</span><span class="brand-sub">WATCHER</span>
      </a>
      <span class="clock" data-clock></span>
    </header>

    <main transition:name="main" transition:animate={pageAnim}>
      <slot />
    </main>

    <footer class="hints">
      <div class="hint-row">
        {
          hints.map((h) => (
            <span class="hint">
              <Glyph button={h.button} />
              {h.label}
            </span>
          ))
        }
      </div>
      <button class="hint sound" type="button" data-sound aria-pressed="false" title="Toggle menu sounds">
        <Glyph button="square" />
        <span class="on">Sound on</span><span class="off">Sound off</span>
      </button>
    </footer>
    <div class="toast" data-toast role="status" aria-live="polite"></div>

    <script>
      import '../scripts/controls';
      import '../scripts/disc';
      import '../scripts/time';
      // Three.js is the heavy part; the menu works without it, so load it after.
      void import('../scripts/scene');
    </script>
  </body>
</html>
