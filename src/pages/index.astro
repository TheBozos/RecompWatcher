---
import Base from '../layouts/Base.astro';
import SaveIcon from '../components/SaveIcon.astro';
import { getProjects } from '../lib/github';

const all = await getProjects();
const games = all.filter((p) => p.kind === 'game');
const tools = all.filter((p) => p.kind === 'tool');
const base = import.meta.env.BASE_URL;
const first = games[0] ?? tools[0];

// Latest commits across every project, for the activity feed; two per
// project at most so one busy repo does not fill it.
const activity = all
  .flatMap((p) => p.commits.slice(0, 2).map((c) => ({ ...c, project: p })))
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 8);

// What the focus panel shows for a project; shared by its slot and its feed rows.
const focusData = (p: (typeof all)[number]) => ({
  'data-hue': p.hue,
  'data-title': p.title,
  'data-meta': meta(p),
  'data-status': p.status?.text ?? '',
  'data-tone': p.status?.tone ?? '',
  'data-tagline': p.tagline,
  'data-repo-url': p.url,
  'data-last-title': p.commits[0]?.title ?? '',
  'data-last-date': p.commits[0]?.date ?? '',
});

const meta = (p: (typeof all)[number]) =>
  [p.serial, p.region, p.platforms.length ? `PC: ${p.platforms.join(' / ')}` : p.system].filter(Boolean).join('  ·  ');
---

<Base
  title="Recomp Watcher"
  scene="menu"
  hints={[
    { button: 'cross', label: 'Enter' },
    { button: 'triangle', label: 'Repository' },
  ]}
>
  <section class="boot" data-boot aria-hidden="true">
    <div class="boot-inner">
      <p class="boot-logo"><span>RECOMP</span> <span>WATCHER</span></p>
      <p class="boot-tag">PlayStation 2 games, recompiled into native PC programs</p>
      <p class="boot-skip">Press any button</p>
    </div>
  </section>
  <script is:inline>
    try {
      if (!sessionStorage.getItem('rw-booted')) document.querySelector('[data-boot]').classList.add('on');
    } catch {}
  </script>

  <div class="menu">
    <section class="focus" aria-live="polite">
      <p class="eyebrow">Browser · Memory Card / 1</p>
      <h1 data-f="title">{first?.title}</h1>
      <p class="focus-meta" data-f="meta">{first && meta(first)}</p>
      <p class="status" data-f="status" data-tone={first?.status?.tone} hidden={!first?.status}>{first?.status?.text}</p>
      <p class="focus-tag" data-f="tagline">{first?.tagline}</p>
      <p class="focus-last" data-f="last" hidden={!first?.commits[0]}>
        Last update <time data-f="last-date" datetime={first?.commits[0]?.date} data-ago></time>
        <span data-f="last-title">{first?.commits[0]?.title}</span>
      </p>
    </section>

    {
      [
        { label: 'Games', list: games },
        { label: 'System · Tools', list: tools },
      ].map(
        (group) =>
          group.list.length > 0 && (
            <section class="group">
              <h2 class="eyebrow">{group.label}</h2>
              <ul class:list={['slots', group.list[0].kind]}>
                {group.list.map((p) => (
                  <li>
                    <a
                      class="slot"
                      href={`${base}p/${p.slug}/`}
                      style={`--h:${p.hue}`}
                      data-nav
                      data-slug={p.slug}
                      {...focusData(p)}
                      data-autofocus={p === first ? '' : undefined}
                    >
                      <SaveIcon short={p.short} hue={p.hue} kind={p.kind} faces={p.faces} size={p.kind === 'game' ? 72 : 56} />
                      <span class="slot-name">{p.title}</span>
                      {p.downloads.length > 0 && <span class="slot-badge">Download</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ),
      )
    }

    {
      activity.length > 0 && (
        <section class="group activity">
          <h2 class="eyebrow">Recent activity</h2>
          <ul>
            {activity.map((c) => (
              <li>
                <a href={`${base}p/${c.project.slug}/#progress`} data-nav style={`--h:${c.project.hue}`} {...focusData(c.project)}>
                  <span class="act-dot" aria-hidden="true" />
                  <span class="act-project">{c.project.title}</span>
                  <span class="act-title">{c.title}</span>
                  <time datetime={c.date} data-ago />
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <a class="visually-hidden" data-repo href="#" target="_blank" rel="noopener" tabindex="-1">Open repository</a>
  </div>
</Base>

<script>
  import { setScene } from '../scripts/scene-events';
  import { ago } from '../scripts/time';

  function showFocus(el: HTMLElement) {
    const d = el.dataset;
    const set = (k: string, v: string) => {
      const t = document.querySelector<HTMLElement>(`[data-f="${k}"]`);
      if (t) t.textContent = v;
    };
    set('title', d.title ?? '');
    set('meta', d.meta ?? '');
    set('tagline', d.tagline ?? '');
    const status = document.querySelector<HTMLElement>('[data-f="status"]');
    if (status) {
      status.textContent = d.status ?? '';
      status.dataset.tone = d.tone ?? '';
      status.hidden = !d.status;
    }
    const last = document.querySelector<HTMLElement>('[data-f="last"]');
    if (last) {
      last.hidden = !d.lastDate;
      const time = last.querySelector<HTMLTimeElement>('time')!;
      if (d.lastDate) {
        time.dateTime = d.lastDate;
        time.textContent = ago(d.lastDate);
      }
      set('last-title', d.lastTitle ?? '');
    }
    const repo = document.querySelector<HTMLAnchorElement>('[data-repo]');
    if (repo && d.repoUrl) repo.href = d.repoUrl;
  }
  document.addEventListener('rw:selected', (e) => showFocus((e as CustomEvent<HTMLElement>).detail));

  document.addEventListener('astro:page-load', () => {
    const boot = document.querySelector<HTMLElement>('[data-boot].on');
    if (!boot) return;
    setScene({ mode: 'boot' });
    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      try {
        sessionStorage.setItem('rw-booted', '1');
      } catch {}
      boot.classList.add('done');
      const hue = (document.activeElement as HTMLElement | null)?.dataset.hue;
      setScene({ mode: 'menu', hue: hue ? Number(hue) : undefined });
      setTimeout(() => boot.remove(), 900);
      removeEventListener('keydown', skip, true);
      removeEventListener('pointerdown', skip, true);
      removeEventListener('rw:pad-press', skip);
    };
    const skip = (e: Event) => {
      e.preventDefault();
      e.stopPropagation();
      finish();
    };
    addEventListener('keydown', skip, true);
    addEventListener('pointerdown', skip, true);
    addEventListener('rw:pad-press', skip);
    setTimeout(finish, matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 5600);
  });
</script>

<style>
  .menu {
    padding: 4vh var(--gutter) 24px;
    max-width: 1280px;
    margin: 0 auto;
    min-height: calc(100dvh - 120px);
    transition: opacity 0.9s ease 0.2s;
  }
  .boot.on:not(.done) ~ .menu {
    opacity: 0;
  }

  .focus {
    min-height: 220px;
    max-width: 900px;
  }
  .focus h1 {
    margin: 10px 0 6px;
    font-size: clamp(1.8rem, 4.6vw, 3.4rem);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: 0.01em;
    text-shadow: var(--glow);
  }
  .focus-meta {
    margin: 0 0 10px;
    color: var(--ink-dim);
    letter-spacing: 0.08em;
    font-size: 0.9rem;
  }
  .focus .status {
    margin: 0 0 12px;
  }
  .focus-tag {
    margin: 0;
    max-width: 68ch;
    color: var(--ink-dim);
    font-weight: 300;
  }

  .focus-last {
    margin: 10px 0 0;
    font-size: 0.82rem;
    color: var(--ink-faint);
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
  }
  .focus-last time {
    color: var(--ink-dim);
  }
  .focus-last span {
    color: var(--ink-dim);
    font-style: italic;
  }
  .focus-last[hidden] {
    display: none;
  }

  .group {
    margin-top: 34px;
  }

  .activity ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .activity a {
    display: grid;
    grid-template-columns: auto minmax(110px, 220px) minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 12px;
    padding: 9px 12px;
    border-radius: 10px;
    text-decoration: none;
    color: var(--ink-dim);
    font-size: 0.88rem;
    outline: none;
    border: 1px solid transparent;
  }
  .activity a:is(:hover, :focus, :focus-visible) {
    color: var(--ink);
    background: linear-gradient(90deg, hsl(var(--h) 90% 60% / 0.16), transparent);
    border-color: hsl(var(--h) 90% 75% / 0.3);
  }
  .act-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: hsl(var(--h) 90% 65%);
    box-shadow: 0 0 8px hsl(var(--h) 90% 60%);
    align-self: center;
  }
  .act-project {
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .act-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .activity time {
    font-size: 0.78rem;
    color: var(--ink-faint);
    white-space: nowrap;
  }
  .group h2 {
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 8px;
  }
  .slots {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 6px 10px;
  }
  .slots.tool {
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
  }
  .slot {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 6px 6px 14px;
    border-radius: 12px;
    text-decoration: none;
    color: var(--ink-dim);
    outline: none;
    transition: background 0.25s, color 0.25s;
  }
  .slot:focus,
  .slot:focus-visible {
    color: var(--ink);
    background: radial-gradient(ellipse at 50% 40%, hsl(var(--h, 220) 90% 60% / 0.18), transparent 70%);
  }
  .slot:focus::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 12px;
    border: 1px solid var(--line-strong);
  }
  .slot-name {
    font-size: 0.85rem;
    text-align: center;
    line-height: 1.3;
    min-height: 2.6em;
  }
  .slot:focus .slot-name {
    text-shadow: var(--glow);
  }
  .slot-badge {
    position: absolute;
    top: 8px;
    right: 8px;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--good);
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 1px 7px;
  }

  /* Boot ------------------------------------------------------------------- */
  .boot {
    display: none;
  }
  .boot.on {
    position: fixed;
    inset: 0;
    z-index: 10;
    display: grid;
    place-items: center;
    background: #000;
    animation: boot-bg 2.4s ease 0.4s forwards;
    transition: opacity 0.8s ease;
    cursor: pointer;
  }
  .boot.done {
    opacity: 0;
    pointer-events: none;
  }
  .boot-inner {
    text-align: center;
    padding: 0 var(--gutter);
  }
  .boot-logo {
    margin: 0;
    font-size: clamp(2rem, 7vw, 4.6rem);
    letter-spacing: 0.3em;
    font-weight: 200;
    text-shadow: var(--glow);
    opacity: 0;
    animation: boot-in 1.6s ease 1.1s forwards;
  }
  .boot-logo span:first-child {
    font-weight: 700;
  }
  .boot-tag {
    margin: 14px 0 0;
    color: var(--ink-dim);
    letter-spacing: 0.14em;
    font-size: clamp(0.8rem, 2vw, 1rem);
    opacity: 0;
    animation: boot-in 1.2s ease 2.6s forwards;
  }
  .boot-skip {
    position: fixed;
    bottom: 28px;
    left: 0;
    right: 0;
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ink-faint);
    opacity: 0;
    animation: boot-in 1s ease 3.4s forwards;
  }
  @keyframes boot-bg {
    to { background: rgb(0 0 0 / 0.15); }
  }
  @keyframes boot-in {
    from { opacity: 0; filter: blur(10px); letter-spacing: 0.5em; }
    to { opacity: 1; filter: blur(0); }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  @media (max-width: 600px) {
    .activity a {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }
    .act-title {
      grid-column: 2 / -1;
      grid-row: 2;
      white-space: normal;
    }
    .focus { min-height: 190px; }
    .slots { grid-template-columns: repeat(2, 1fr); }
    .slots.tool { grid-template-columns: repeat(3, 1fr); }
  }
  @media (prefers-reduced-motion: reduce) {
    .boot.on { display: none; }
  }
</style>
