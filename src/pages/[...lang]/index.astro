---
import Base from '../../layouts/Base.astro';
import SaveIcon from '../../components/SaveIcon.astro';
import Blocks from '../../components/Blocks.astro';
import AuthorTag from '../../components/AuthorTag.astro';
import { getProjects } from '../../lib/github';
import { BADGE_DAYS, eventsOf } from '../../lib/events';
import { langPaths, localHref, useT, type Lang } from '../../i18n';

export const getStaticPaths = langPaths;

const lang = Astro.props.lang as Lang;
const t = useT(lang);
const all = await getProjects();
const games = all.filter((p) => p.kind === 'game');
const tools = all.filter((p) => p.kind === 'tool');
const first = games[0] ?? tools[0];

// Everyone with a game here, for the "show games by" filter.
const authors = [...new Map(games.map((p) => [p.author.login, p.author])).values()].map((a) => ({
  ...a,
  count: games.filter((p) => p.author.login === a.login).length,
}));

// Latest commits across every project, for the activity feed; two per
// project at most so one busy repo does not fill it.
const activity = all
  .flatMap((p) => p.commits.slice(0, 2).map((c) => ({ ...c, project: p })))
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 10);

// What the focus panel shows for a project; shared by its slot and its feed rows.
const focusData = (p: (typeof all)[number]) => ({
  'data-hue': p.hue,
  'data-title': p.title,
  'data-meta': meta(p),
  'data-status': p.status?.text ?? '',
  'data-tone': p.status?.tone ?? '',
  'data-tagline': p.tagline,
  'data-repo-url': p.url,
  'data-last-title': p.commits[0]?.title ?? '',
  'data-last-date': p.commits[0]?.date ?? '',
  'data-project': p.slug,
  'data-author': p.author.login,
  'data-author-avatar': p.author.avatar,
  'data-ms': p.milestones
    ? t('msCount', { done: p.milestones.items.filter((i) => i.step === 'done').length, total: p.milestones.items.length })
    : '',
});
const msOf = (p: (typeof all)[number]) => p.milestones?.items.map((i) => i.step);

// The badge a cube may wear: its latest event and until when (decided in the
// browser, since the site is only rebuilt once a day).
const BADGE_TEXT = { release: t('badgeRelease'), status: t('badgeStatus'), start: t('badgeStart') };
const badgeOf = (p: (typeof all)[number]) => {
  const latest = eventsOf(p, '')[0];
  if (!latest) return undefined;
  const until = new Date(new Date(latest.date).getTime() + BADGE_DAYS[latest.kind] * 864e5).toISOString();
  return { text: BADGE_TEXT[latest.kind], kind: latest.kind, until };
};

const meta = (p: (typeof all)[number]) =>
  [p.serial, p.region, p.platforms.length ? `PC: ${p.platforms.join(' / ')}` : p.system].filter(Boolean).join('  ·  ');
---

<Base
  lang={lang}
  path=""
  title="Recomp Watcher"
  scene="menu"
  hints={[
    { button: 'cross', label: t('hintEnter') },
    { button: 'triangle', label: t('hintRepository') },
  ]}
>
  <section class="boot" data-boot aria-hidden="true">
    <div class="boot-inner">
      <p class="boot-logo"><span>RECOMP</span> <span>WATCHER</span></p>
      <p class="boot-tag">{t('bootTag')}</p>
      <p class="boot-skip"><span class="pointer-only">{t('bootSkip')}</span><span class="touch-only">{t('bootTap')}</span></p>
    </div>
  </section>
  <script is:inline>
    // The startup screen, as set in System Configuration: once per visit (default), every time, or never.
    try {
      var intro = JSON.parse(localStorage.getItem('rw-settings') || '{}').intro || 'session';
      if (intro === 'always' || (intro === 'session' && !sessionStorage.getItem('rw-booted'))) {
        document.querySelector('[data-boot]').classList.add('on');
      }
    } catch (e) {}
  </script>

  <div class="menu">
    <section class="touch-intro touch-only">
      <p class="eyebrow">{t('browserEyebrow')}</p>
      <h1>Recomp Watcher</h1>
      <p>{t('touchIntro', { games: games.length, authors: authors.map((a) => a.login).join(' & ') || first?.author.login || '' })}</p>
    </section>

    <section class="focus pointer-only" aria-live="polite">
      <p class="eyebrow">{t('browserEyebrow')}</p>
      <h1 data-f="title">{first?.title}</h1>
      <p class="focus-author" data-f="author-row">
        {first && <AuthorTag author={first.author} prefix={t('by')} />}
      </p>
      <p class="focus-meta" data-f="meta">{first && meta(first)}</p>
      <p class="status" data-f="status" data-tone={first?.status?.tone} hidden={!first?.status}>{first?.status?.text}</p>
      <p class="focus-tag" data-f="tagline">{first?.tagline}</p>
      <div class="focus-ms" data-f="ms-row" hidden={!first?.milestones} style={first && `--h:${first.hue}`}>
        <div class="focus-blocks" data-f="blocks">
          {first && msOf(first) && <Blocks steps={msOf(first)!} size="lg" lang={lang} />}
        </div>
        <span data-f="ms">{first && focusData(first)['data-ms']}</span>
      </div>
      <p class="focus-last" data-f="last" hidden={!first?.commits[0]}>
        {t('lastUpdate')} <time data-f="last-date" datetime={first?.commits[0]?.date} data-ago></time>
        <span data-f="last-title">{first?.commits[0]?.title}</span>
      </p>
    </section>

    {
      [
        { label: t('games'), list: games },
        { label: t('tools'), list: tools },
      ].map(
        (group) =>
          group.list.length > 0 && (
            <section class="group">
              <div class="group-head">
                <h2 class="eyebrow">{group.label}</h2>
                {group.list === games && authors.length > 1 && (
                  <div class="authors" role="group" aria-label={t('showGamesBy')}>
                    <button type="button" data-nav data-author-filter="" aria-pressed="true">
                      {t('everyone')} <span class="count">{games.length}</span>
                    </button>
                    {authors.map((a) => (
                      <button type="button" data-nav data-author-filter={a.login} aria-pressed="false" aria-label={t('showAuthorGames', { login: a.login, count: a.count })}>
                        <img src={a.avatar} alt="" width="20" height="20" />
                        {a.login} <span class="count">{a.count}</span>
                      </button>
                    ))}
                  </div>
                )}
              </div>
              <ul class:list={['slots', group.list[0].kind]}>
                {group.list.map((p) => (
                  <li>
                    <a
                      class="slot"
                      href={localHref(lang, `p/${p.slug}/`)}
                      style={`--h:${p.hue}`}
                      data-nav
                      data-slug={p.slug}
                      {...focusData(p)}
                      data-autofocus={p === first ? '' : undefined}
                    >
                      <SaveIcon short={p.short} hue={p.hue} kind={p.kind} faces={p.faces} size={p.kind === 'game' ? 72 : 56} />
                      {authors.length > 1 && (
                        <img class="slot-avatar" src={p.author.avatar} alt={`${t('by')} ${p.author.login}`} title={`${t('by')} ${p.author.login}`} width="22" height="22" />
                      )}
                      <span class="slot-name">{p.title}</span>
                      {msOf(p) && <Blocks steps={msOf(p)!} lang={lang} />}
                      <span class="slot-badges">
                        {badgeOf(p) && (
                          <span class="slot-badge fresh" data-kind={badgeOf(p)!.kind} data-until={badgeOf(p)!.until} hidden>
                            {badgeOf(p)!.text}
                          </span>
                        )}
                        {p.downloads.length > 0 && <span class="slot-badge">{t('badgeDownload')}</span>}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ),
      )
    }

    {
      activity.length > 0 && (
        <section class="group activity">
          <div class="group-head">
            <h2 class="eyebrow">{t('recentActivity')}</h2>
            <a class="feed-link" href={localHref('en', 'feed.xml')}>{t('rssFeed')}</a>
          </div>
          <ul>
            {activity.map((c) => (
              <li>
                <a href={localHref(lang, `p/${c.project.slug}/#progress`)} data-nav style={`--h:${c.project.hue}`} {...focusData(c.project)}>
                  <img class="act-avatar" src={c.project.author.avatar} alt={c.project.author.login} title={c.project.author.login} width="20" height="20" />
                  <span class="act-project">{c.project.title}</span>
                  <span class="act-title">{c.title}</span>
                  <time datetime={c.date} data-ago />
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <a class="visually-hidden" data-repo href="#" target="_blank" rel="noopener" tabindex="-1">{t('openRepository')}</a>
  </div>
</Base>

<script>
  import { setScene } from '../../scripts/scene-events';
  import { ago } from '../../scripts/time';

  function showFocus(el: HTMLElement) {
    const d = el.dataset;
    const set = (k: string, v: string) => {
      const t = document.querySelector<HTMLElement>(`[data-f="${k}"]`);
      if (t) t.textContent = v;
    };
    set('title', d.title ?? '');
    const author = document.querySelector<HTMLElement>('[data-f="author-row"]');
    if (author && d.author) {
      author.querySelector('.login')!.textContent = d.author;
      author.querySelector('img')!.src = d.authorAvatar ?? '';
    }
    set('meta', d.meta ?? '');
    set('tagline', d.tagline ?? '');
    const status = document.querySelector<HTMLElement>('[data-f="status"]');
    if (status) {
      status.textContent = d.status ?? '';
      status.dataset.tone = d.tone ?? '';
      status.hidden = !d.status;
    }
    // The header's block meter is a larger copy of the selected cube's.
    const msRow = document.querySelector<HTMLElement>('[data-f="ms-row"]');
    const blocks = document.querySelector(`.slot[data-slug="${d.project}"] .blocks`);
    if (msRow) {
      msRow.hidden = !blocks;
      msRow.style.setProperty('--h', d.hue ?? '220');
      set('ms', d.ms ?? '');
      if (blocks) {
        const big = blocks.cloneNode(true) as HTMLElement;
        big.classList.replace('sm', 'lg');
        msRow.querySelector('[data-f="blocks"]')!.replaceChildren(big);
      }
    }
    const last = document.querySelector<HTMLElement>('[data-f="last"]');
    if (last) {
      last.hidden = !d.lastDate;
      const time = last.querySelector<HTMLTimeElement>('time')!;
      if (d.lastDate) {
        time.dateTime = d.lastDate;
        time.textContent = ago(d.lastDate);
      }
      set('last-title', d.lastTitle ?? '');
    }
    const repo = document.querySelector<HTMLAnchorElement>('[data-repo]');
    if (repo && d.repoUrl) repo.href = d.repoUrl;
  }
  document.addEventListener('rw:selected', (e) => showFocus((e as CustomEvent<HTMLElement>).detail));

  // "Show games by": hides the other authors' games (remembered for the visit).
  function filterBy(login: string) {
    for (const btn of document.querySelectorAll<HTMLElement>('[data-author-filter]')) {
      btn.setAttribute('aria-pressed', String(btn.dataset.authorFilter === login));
    }
    for (const slot of document.querySelectorAll<HTMLElement>('.slots.game .slot')) {
      slot.parentElement!.hidden = !!login && slot.dataset.author !== login;
    }
    try {
      sessionStorage.setItem('rw-author', login);
    } catch {}
  }
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-author-filter]');
    if (btn) filterBy(btn.dataset.authorFilter ?? '');
  });

  // Badges for recent events, shown until their date passes.
  document.addEventListener('astro:page-load', () => {
    const now = Date.now();
    for (const b of document.querySelectorAll<HTMLElement>('.slot-badge.fresh')) {
      b.hidden = new Date(b.dataset.until!).getTime() < now;
    }
  });

  document.addEventListener('astro:page-load', () => {
    let saved = '';
    try {
      saved = sessionStorage.getItem('rw-author') ?? '';
    } catch {}
    if (document.querySelector(`[data-author-filter="${CSS.escape(saved)}"]`)) filterBy(saved);
  });

  document.addEventListener('astro:page-load', () => {
    const boot = document.querySelector<HTMLElement>('[data-boot].on');
    if (!boot) return;
    setScene({ mode: 'boot' });
    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      try {
        sessionStorage.setItem('rw-booted', '1');
      } catch {}
      boot.classList.add('done');
      const hue = (document.activeElement as HTMLElement | null)?.dataset.hue;
      setScene({ mode: 'menu', hue: hue ? Number(hue) : undefined });
      setTimeout(() => boot.remove(), 900);
      removeEventListener('keydown', skip, true);
      removeEventListener('pointerdown', skip, true);
      removeEventListener('rw:pad-press', skip);
    };
    const skip = (e: Event) => {
      e.preventDefault();
      e.stopPropagation();
      finish();
    };
    addEventListener('keydown', skip, true);
    addEventListener('pointerdown', skip, true);
    addEventListener('rw:pad-press', skip);
    setTimeout(finish, document.documentElement.dataset.motion === 'reduced' ? 0 : 5600);
  });
</script>

<style>
  .menu {
    padding: 4vh var(--gutter) 24px;
    max-width: 1280px;
    margin: 0 auto;
    min-height: calc(100dvh - 120px);
    transition: opacity 0.9s ease 0.2s;
  }
  .boot.on:not(.done) ~ .menu {
    opacity: 0;
  }

  .touch-intro h1 {
    margin: 8px 0 8px;
    font-size: 2rem;
    font-weight: 300;
    text-shadow: var(--glow);
  }
  .touch-intro p:last-child {
    margin: 0;
    color: var(--ink-dim);
    font-weight: 300;
  }
  .focus {
    min-height: 220px;
    max-width: 900px;
  }
  .focus h1 {
    margin: 10px 0 6px;
    font-size: clamp(1.8rem, 4.6vw, 3.4rem);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: 0.01em;
    text-shadow: var(--glow);
  }
  .focus-meta {
    margin: 0 0 10px;
    color: var(--ink-dim);
    letter-spacing: 0.08em;
    font-size: 0.9rem;
  }
  .focus .status {
    margin: 0 0 12px;
  }
  .focus-tag {
    margin: 0;
    max-width: 68ch;
    color: var(--ink-dim);
    font-weight: 300;
  }

  .focus-ms {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 12px 0 0;
    font-size: 0.82rem;
    color: var(--ink-dim);
  }
  .focus-ms[hidden] {
    display: none;
  }
  .focus-blocks {
    width: min(360px, 55vw);
  }
  .slot :global(.blocks) {
    margin-top: 6px;
  }
  .focus-last {
    margin: 10px 0 0;
    font-size: 0.82rem;
    color: var(--ink-faint);
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
  }
  .focus-last time {
    color: var(--ink-dim);
  }
  .focus-last span {
    color: var(--ink-dim);
    font-style: italic;
  }
  .focus-last[hidden] {
    display: none;
  }

  .group {
    margin-top: 34px;
  }

  .activity ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .activity a {
    display: grid;
    grid-template-columns: auto minmax(110px, 220px) minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 12px;
    padding: 9px 12px;
    border-radius: 10px;
    text-decoration: none;
    color: var(--ink-dim);
    font-size: 0.88rem;
    outline: none;
    border: 1px solid transparent;
  }
  .activity a:is(:hover, :focus, :focus-visible) {
    color: var(--ink);
    background: linear-gradient(90deg, hsl(var(--h) 90% 60% / 0.16), transparent);
    border-color: hsl(var(--h) 90% 75% / 0.3);
  }
  .act-avatar {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 1.5px solid hsl(var(--h) 90% 65%);
    box-shadow: 0 0 8px hsl(var(--h) 90% 60% / 0.6);
    align-self: center;
  }
  .act-project {
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .act-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .activity time {
    font-size: 0.78rem;
    color: var(--ink-faint);
    white-space: nowrap;
  }
  .group h2 {
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 8px;
  }
  .group-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 8px;
  }
  .group-head h2 {
    padding-top: 8px;
    border-bottom: 0;
    margin-bottom: 0;
  }
  .authors {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-bottom: 8px;
  }
  .authors button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: inherit;
    font-size: 0.8rem;
    color: var(--ink-dim);
    padding: 3px 10px 3px 6px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgb(255 255 255 / 0.03);
    cursor: pointer;
    outline: none;
  }
  .authors button:first-child {
    padding-left: 10px;
  }
  .authors button img {
    width: 18px;
    height: 18px;
    border-radius: 50%;
  }
  .authors button:is(:hover, :focus, :focus-visible) {
    color: var(--ink);
    border-color: var(--line-strong);
  }
  .authors button[aria-pressed='true'] {
    color: var(--ink);
    border-color: rgb(160 190 255 / 0.6);
    background: rgb(110 150 255 / 0.18);
    text-shadow: var(--glow);
  }
  .count {
    font-size: 0.72rem;
    color: var(--ink-faint);
  }
  .slots li[hidden] {
    display: none;
  }
  .slot-avatar {
    position: absolute;
    top: 8px;
    left: 8px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1.5px solid hsl(var(--h) 90% 70% / 0.8);
    box-shadow: 0 0 8px rgb(0 0 0 / 0.6);
  }
  .focus-author {
    margin: -2px 0 10px;
    font-size: 0.9rem;
  }
  .slots {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 6px 10px;
  }
  .slots.tool {
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
  }
  .slot {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 6px 6px 14px;
    border-radius: 12px;
    text-decoration: none;
    color: var(--ink-dim);
    outline: none;
    transition: background 0.25s, color 0.25s;
  }
  .slot:focus,
  .slot:focus-visible {
    color: var(--ink);
    background: radial-gradient(ellipse at 50% 40%, hsl(var(--h, 220) 90% 60% / 0.18), transparent 70%);
  }
  .slot:focus::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 12px;
    border: 1px solid var(--line-strong);
  }
  .slot-name {
    font-size: 0.85rem;
    text-align: center;
    line-height: 1.3;
    min-height: 2.6em;
  }
  .slot:focus .slot-name {
    text-shadow: var(--glow);
  }
  .slot-badges {
    position: absolute;
    top: 8px;
    right: 8px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
  }
  .slot-badge[hidden] {
    display: none;
  }
  .slot-badge.fresh {
    color: #fff;
    border-color: hsl(var(--h) 90% 70%);
    background: hsl(var(--h) 85% 45% / 0.75);
    box-shadow: 0 0 10px hsl(var(--h) 90% 60% / 0.6);
  }
  .slot-badge.fresh[data-kind='release'] {
    background: color-mix(in srgb, var(--good) 70%, black);
    border-color: var(--good);
  }
  .feed-link {
    font-size: 0.78rem;
    color: var(--ink-dim);
    padding-bottom: 8px;
  }
  .slot-badge {
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--good);
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 1px 7px;
  }

  /* Boot ------------------------------------------------------------------- */
  .boot {
    display: none;
  }
  .boot.on {
    position: fixed;
    inset: 0;
    z-index: 10;
    display: grid;
    place-items: center;
    background: #000;
    animation: boot-bg 2.4s ease 0.4s forwards;
    transition: opacity 0.8s ease;
    cursor: pointer;
  }
  .boot.done {
    opacity: 0;
    pointer-events: none;
  }
  .boot-inner {
    text-align: center;
    padding: 0 var(--gutter);
  }
  .boot-logo {
    margin: 0;
    font-size: clamp(2rem, 7vw, 4.6rem);
    letter-spacing: 0.3em;
    font-weight: 200;
    text-shadow: var(--glow);
    opacity: 0;
    animation: boot-in 1.6s ease 1.1s forwards;
  }
  .boot-logo span:first-child {
    font-weight: 700;
  }
  .boot-tag {
    margin: 14px 0 0;
    color: var(--ink-dim);
    letter-spacing: 0.14em;
    font-size: clamp(0.8rem, 2vw, 1rem);
    opacity: 0;
    animation: boot-in 1.2s ease 2.6s forwards;
  }
  .boot-skip {
    position: fixed;
    bottom: 28px;
    left: 0;
    right: 0;
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ink-faint);
    opacity: 0;
    animation: boot-in 1s ease 3.4s forwards;
  }
  @keyframes boot-bg {
    to { background: rgb(0 0 0 / 0.15); }
  }
  @keyframes boot-in {
    from { opacity: 0; filter: blur(10px); letter-spacing: 0.5em; }
    to { opacity: 1; filter: blur(0); }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  @media (max-width: 600px) {
    .activity a {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }
    .act-title {
      grid-column: 2 / -1;
      grid-row: 2;
      white-space: normal;
    }
    .focus { min-height: 190px; }
